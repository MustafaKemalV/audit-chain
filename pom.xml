<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>io.github.mustafakemalv</groupId>
    <artifactId>audit-chain-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>audit-chain-parent</name>
    <description>Tamper-evident, HMAC-SHA256 hash-chained, append-only audit log for Spring Boot.</description>
    <url child.project.url.inherit.append.path="false">https://github.com/MustafaKemalV/audit-chain</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
        </license>
    </licenses>

    <!--
        Declared explicitly because spring-boot-starter-parent declares its own. Without these,
        every artifact here would be published to Maven Central crediting Spring / VMware as the
        developer, with an SCM URL pointing at spring-projects/spring-boot. Central's validation
        would not object, since the fields are present, and a published version cannot be corrected.

        The child.scm.*.inherit.append.path attributes stop Maven appending each module's artifactId
        to the inherited URLs.
    -->
    <developers>
        <developer>
            <id>MustafaKemalV</id>
            <name>Mustafa Kemal Vural</name>
            <url>https://github.com/MustafaKemalV</url>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/MustafaKemalV/audit-chain.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/MustafaKemalV/audit-chain.git</developerConnection>
        <url>https://github.com/MustafaKemalV/audit-chain</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>audit-chain-core</module>
        <module>audit-chain-spring-boot-autoconfigure</module>
        <module>audit-chain-spring-boot-starter</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!--
            JDK 23 turned implicit annotation processing off, so spring-boot-configuration-processor
            silently stopped running and the jar shipped without spring-configuration-metadata.json.
            Without that file an IDE offers no completion for audit-chain.* and a typo in a property
            name fails at startup with nothing pointing at the cause.
        -->
        <maven.compiler.proc>full</maven.compiler.proc>
        <!-- Fixed timestamps make the jars byte-reproducible; bump on each release. -->
        <project.build.outputTimestamp>2026-09-03T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Signing and publishing, kept out of the everyday build so `mvn install` stays fast and
            needs no GPG key. Activate with -Prelease.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!--
                                Upload and validate, then wait for a human to press Publish in the
                                Portal. Publishing is irreversible, so the first release should be
                                looked at before it becomes permanent.
                            -->
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <!-- version managed by spring-boot-dependencies -->
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <!-- version managed by spring-boot-dependencies -->
                        <configuration>
                            <doclint>none</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <!-- Pinned: Spring's parent manages the two plugins above, but not this one. -->
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Mutation testing, run on demand with -Pmutation. In a library whose whole claim is that
            tampering is detectable, "which production line can I delete with the tests still green"
            is a security question, not a style one. Kept out of the default build because it is slow.
        -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>1.20.4</version>
                        <configuration>
                            <targetClasses>
                                <param>io.github.mustafakemalv.auditchain.*</param>
                            </targetClasses>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats>
                                <param>HTML</param>
                                <param>CSV</param>
                            </outputFormats>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>1.2.3</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.mustafakemalv</groupId>
                <artifactId>audit-chain-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.mustafakemalv</groupId>
                <artifactId>audit-chain-spring-boot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
