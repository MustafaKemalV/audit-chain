<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.mustafakemalv</groupId>
        <artifactId>audit-chain-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>audit-chain-spring-boot-starter</artifactId>

    <name>audit-chain-spring-boot-starter</name>
    <description>Starter for audit-chain: add this one dependency to get a tamper-evident,
        append-only audit log auto-configured in a Spring Boot application.</description>
    <url>https://github.com/MustafaKemalV/audit-chain</url>

    <!-- A starter carries no code of its own; it only pulls in what an application needs. -->
    <dependencies>
        <dependency>
            <groupId>io.github.mustafakemalv</groupId>
            <artifactId>audit-chain-spring-boot-autoconfigure</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- Frozen at publication: a JPMS consumer names the module by this. -->
                            <Automatic-Module-Name>io.github.mustafakemalv.auditchain.starter</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!--
            Central requires a sources jar and a javadoc jar for every artifact, but this module has
            no sources, so maven-source-plugin and maven-javadoc-plugin both skip silently and the
            build still succeeds. The bundle would then be rejected at validation, which is a slow
            way to find out. Central explicitly allows placeholder jars for exactly this case, and
            Spring's own code-less starters ship them too.

            The two real plugins are skipped here so nothing races them for the same file name.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <configuration>
                            <skipSource>true</skipSource>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>placeholder-sources</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>sources</classifier>
                                    <classesDirectory>${project.basedir}/src/placeholder</classesDirectory>
                                </configuration>
                            </execution>
                            <execution>
                                <id>placeholder-javadoc</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>javadoc</classifier>
                                    <classesDirectory>${project.basedir}/src/placeholder</classesDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
